{
  "name": "goldfished",
  "version": "0.1.3",
  "description": "How long is your coding agent's memory? Measure what survives compaction, then keep your goal and rules in front of it.",
  "type": "module",
  "bin": {
    "goldfished": "bin/goldfished.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Jonathan Nguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoangJN/goldfished.git"
  },
  "files": [
    "bin",
    "src",
    "hooks",
    ".claude-plugin"
  ],
  "scripts": {
    "test": "node --import ./test/no-network.mjs --test",
    "gate": "node scripts/gate.mjs",
    "coverage": "node --import ./test/no-network.mjs --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-include=\"src/**\" --test-coverage-include=\"bin/**\" --test-coverage-include=\"hooks/**\" --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-exclude=\"bench/**\" --test"
  }
}
